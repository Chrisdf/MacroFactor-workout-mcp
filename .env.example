# ── Firebase backend (default) ────────────────────────────────────────────────
# Your MacroFactor account credentials
MACROFACTOR_EMAIL=you@example.com
MACROFACTOR_PASSWORD=yourpassword

# Firebase project config — find in Firebase Console → Project Settings → General
FIREBASE_API_KEY=AIzaSy...
FIREBASE_PROJECT_ID=sbs-diet-app

# ── Backend selection ─────────────────────────────────────────────────────────
# 'firebase' (default) or 'rest'
API_BACKEND=firebase

# ── Generic REST backend (only if API_BACKEND=rest) ───────────────────────────
REST_API_BASE_URL=https://api.example.com/v1
REST_API_TOKEN=your_bearer_token_here
