{
  "name": "macrofactor-workout-mcp",
  "version": "0.1.0",
  "description": "MCP server for MacroFactor workout tracking — log workouts, read history, manage training plans",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "macrofactor-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "dotenv": "^16.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
